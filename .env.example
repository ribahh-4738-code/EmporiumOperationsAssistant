# PostgreSQL connection (used by scripts and future application code)
# Default port 5435 avoids conflict with a system PostgreSQL on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=postgres
POSTGRES_PASSWORD=emporium_dev
POSTGRES_DB=emporium_operation

# Docker PostgreSQL (used by ./install.sh)
EMPORIUM_DOCKER_CONTAINER=emporium_ops_postgres
EMPORIUM_DOCKER_IMAGE=postgres:16-alpine
EMPORIUM_DOCKER_VOLUME=emporium_ops_pgdata

# Assistant / LLM
ASSISTANT_DISPLAY_NAME=Maiara
ASSISTANT_PROFILE_NAME=maiara
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# LLM_TEMPERATURE=0.7
CHAT_HISTORY_LIMIT=20
CHAT_CHANNEL=cli

# Observability (Marco 6)
ASSISTANT_LOG_PATH=.run/assistant.jsonl
GEMINI_DAILY_TOKEN_BUDGET=0
CATALOG_SEARCH_LIMIT=5

# Pedidos no chat (Marco 7) — opcional; ou ./chat.sh --customer-id N
# CHAT_CUSTOMER_ID=
ORDER_CONTEXT_LIMIT=5
ORDER_DETAIL_MAX_ITEMS=20

# ChromaDB (Docker via ./install.sh)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=store_policies
RAG_TOP_K=5
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=120
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMPORIUM_CHROMA_CONTAINER=emporium_ops_chroma
# Pin server image to match Python package chromadb (~1.5.x)
EMPORIUM_CHROMA_IMAGE=chromadb/chroma:1.5.9
EMPORIUM_CHROMA_VOLUME=emporium_ops_chromadata
EMPORIUM_CHROMA_ADMIN_CONTAINER=emporium_ops_chroma_admin
# Local build (Chroma 1.5 / API v2). Hub images sanderdw/fengzhichao are v1-only → Admin 500.
# First time: ./scripts/chroma/build_chroma_admin_image.sh (install runs this if missing)
EMPORIUM_CHROMA_ADMIN_IMAGE=emporium-chromadb-admin:1.5
CHROMA_ADMIN_CONTAINER_PORT=3001
# Host port for Admin UI (change if busy, e.g. 3002 when 3001 is another project)
CHROMA_ADMIN_PORT=3001
